# ============ App ============
ENVIRONMENT=dev
LOG_LEVEL=INFO
SERVER_HOST=127.0.0.1
SERVER_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============ Identity ============
USER_NAME=Dheeraj
USER_ADDRESS_FORM=sir

# ============ LLM provider ============
# AI_PROVIDER: groq | openrouter | openai_compatible
AI_PROVIDER=groq
AI_MODEL=llama-3.3-70b-versatile
AI_FAST_MODEL=llama-3.1-8b-instant
AI_API_KEY=
# Required when AI_PROVIDER is not groq:
# AI_BASE_URL=https://openrouter.ai/api/v1

# Groq key also used for Whisper STT fallback and vision tools
GROQ_API_KEY=

# ============ Database (native PostgreSQL) ============
# NOTE: if your password contains special characters like @, URL-encode it
# (e.g. @ becomes %40). See: urllib.parse.quote_plus
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@127.0.0.1:5432/jarvis

# ============ Vector memory (Qdrant) ============
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=jarvis_memory
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============ Voice ============
# STT_PROVIDER: sarvam | groq_whisper | local_whisper
STT_PROVIDER=sarvam
# TTS_PROVIDER: sarvam | edge
TTS_PROVIDER=sarvam
# Bulbul v3 speakers (validated): priya, neha, simran, kavya, ritu, pooja,
# aditya, ashutosh, rahul, rohan, amit, dev
TTS_VOICE=priya

SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_SPEAKER=abhilash

WAKE_WORD_MODELS=hey_jarvis
WAKE_WORD_THRESHOLD=0.5
VAD_ENABLED=true

# ============ Agent limits ============
AGENT_MAX_STEPS=8
AGENT_STEP_TIMEOUT_SECONDS=60
LLM_REQUEST_TIMEOUT_SECONDS=30
VOICE_COMMAND_TIMEOUT_SECONDS=10

# ============ Proactive ============
PROACTIVE_ENABLED=false
QUIET_HOURS_START=22:00
QUIET_HOURS_END=08:00

# Voice barge-in (interrupt TTS by speaking). Needs headphones/AEC to avoid
# JARVIS cutting itself off on speaker+mic rigs.
BARGE_IN_ENABLED=false
